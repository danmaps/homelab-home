# To reach from your iPhone with Tailscale enabled, put Conductor's actual tailnet IP here.
# Otherwise keep 127.0.0.1 and use a local HTTPS/Tailscale reverse proxy.
SOLO_BIND_IP=127.0.0.1
SOLO_INGEST_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
SOLO_READ_USER=runner
SOLO_READ_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_24_PLUS_CHARACTER_SECRET
SOLO_MAX_MB=25