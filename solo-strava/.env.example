# Copy this to .env and use your OWN generated secrets. Never commit it.
# Copy the matching API and ingest tokens from the PulsHealth server/.env.
ATLAS_PORT=3498
ATLAS_USERNAME=runner
ATLAS_PASSWORD=REPLACE_WITH_32_RANDOM_CHARACTERS
PULS_API_URL=http://127.0.0.1:8081
PULS_API_TOKEN=REPLACE_WITH_PULS_API_TOKEN
PULS_INGEST_URL=http://127.0.0.1:8080
# Read access to route endpoints currently uses a token that also authorizes writes.
# This is held server-side; it never goes to the browser.
PULS_INGEST_TOKEN=REPLACE_WITH_PULS_TOKEN