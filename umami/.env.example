# Copy this file to umami/.env and replace every placeholder.
# Generate long random values, for example:
#   openssl rand -base64 32
# Keep this file private and never commit the real .env.

POSTGRES_DB=umami
POSTGRES_USER=umami
POSTGRES_PASSWORD=replace-with-a-strong-db-password
APP_SECRET=replace-with-a-long-random-secret
UMAMI_PORT=3002

# Optional documentation value only. Caddy will proxy this hostname to localhost:${UMAMI_PORT}.
UMAMI_DOMAIN=analytics.dannymcvey.com
